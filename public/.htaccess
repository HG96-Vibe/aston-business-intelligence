# ABI website — Apache rules for Namecheap / cPanel
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always HTTPS, and no "www."
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://astonbusinessintelligence.co.uk%{REQUEST_URI} [L,R=301]

  # Old addresses
  RewriteRule ^work/?$ /services/ [L,R=301]
  RewriteRule ^health-check/?$ /scorecard/ [L,R=301]

  # Pages live in folders (about/index.html): add the trailing slash if it's missing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

# Don't serve hidden files (.htaccess, .user.ini) or any log files PHP may write
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "(^error_log$|\.log$)">
  Require all denied
</FilesMatch>

# send.php is the only script on this site: refuse to run any other PHP file
<FilesMatch "\.(php|phtml|phar)$">
  Require all denied
</FilesMatch>
<Files "send.php">
  Require all granted
</Files>

<IfModule mod_headers.c>
  # Browsers always use https for this site (1 year)
  Header always set Strict-Transport-Security "max-age=31536000"
  # The site never uses the camera, microphone, location, payments or USB
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Build files have content hashes in their names, so they can be cached for a year
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>
